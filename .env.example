# ============================================================
# Variables de entorno — Portal de Clientes Fondo Privado
# Copiá este archivo a ".env.local" y completá los valores.
# ".env.local" NUNCA se sube a git (ya está en .gitignore).
# ============================================================

# --- Supabase (Project Settings > API) ---
# URL del proyecto, ej: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key. Es publica a proposito (va al navegador),
# la seguridad real la da RLS en la base de datos, no esta key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRETA. Solo se usa en el servidor
# (Server Actions / Route Handlers), nunca en el navegador.
# Permite bypassear RLS e invitar usuarios por email.
SUPABASE_SERVICE_ROLE_KEY=

# --- Base de datos (Project Settings > Database) ---
# Connection string con PgBouncer (pooled), puerto 6543.
# La usa la app en runtime (muchas conexiones cortas).
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connection string directa, puerto 5432.
# La usa Prisma solo para migraciones (pgbouncer no soporta
# prepared statements en modo transaccion).
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Auto-sync del Excel (ver README, seccion "Auto-sync") ---
# Secreto compartido entre el servidor (este .env.local / Vercel) y el
# watcher local (scripts/watch-excel.mjs). Genera uno largo y random,
# nunca lo escribas en el codigo. Necesario en el servidor (local Y
# Vercel) para que /api/importar-auto acepte el pedido.
AUTO_IMPORT_SECRET=

# UUID y email de la cuenta admin real, para que las importaciones
# automaticas queden atribuidas correctamente en import_batches/auditoria.
# El UUID se ve en Supabase > Authentication > Users.
AUTO_IMPORT_ACTOR_ID=
AUTO_IMPORT_ACTOR_EMAIL=

# --- Solo para el watcher local (scripts/watch-excel.mjs) ---
# No hace falta configurarlas en Vercel, solo en tu .env.local.
# Ruta al Excel de trabajo real en tu compu (NO el de docs/, que es solo
# un ejemplo).
AUTO_IMPORT_FILE_PATH=
# A donde mandarlo: localhost mientras probas, la URL de produccion
# cuando ya confiaste en el flujo.
AUTO_IMPORT_URL=http://localhost:3000/api/importar-auto
